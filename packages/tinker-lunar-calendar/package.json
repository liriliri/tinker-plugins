{
  "name": "tinker-lunar-calendar",
  "version": "0.1.1",
  "description": "Lunar Calendar Plugin for TINKER",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" \"*.{html,json,js,ts}\" --write"
  },
  "keywords": [
    "tinker",
    "lunar-calendar"
  ],
  "tinker": {
    "name": "Lunar Calendar",
    "description": "A perpetual calendar with lunar dates, solar terms, Chinese holidays, and almanac details (gan-zhi, yi/ji, chong/sha)",
    "main": "dist/index.html",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "万年历",
        "description": "支持农历、节气、法定节假日与黄历宜忌（干支、冲煞等）的万年历"
      }
    },
    "mcp": {
      "tools": {
        "query": {
          "description": "Query lunar calendar details for a solar date. Updates the plugin UI and returns lunar date, gan-zhi, solar term, yi/ji, and related almanac info. Omitting year/month/day uses today.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "year": {
                "type": "integer",
                "description": "Solar year (defaults to today)"
              },
              "month": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12,
                "description": "Solar month 1-12 (defaults to today)"
              },
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31,
                "description": "Solar day of month (defaults to today)"
              }
            }
          }
        }
      }
    }
  },
  "devDependencies": {
    "lunar-javascript": "^1.7.7"
  }
}
