{
  "name": "tinker-n64",
  "version": "0.1.3",
  "description": "N64 Emulator Plugin for TINKER",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" \"*.{html,json,js,ts}\" --write"
  },
  "keywords": [
    "tinker",
    "n64",
    "emulator"
  ],
  "tinker": {
    "name": "N64",
    "description": "Play N64 ROMs with save state support",
    "main": "dist/index.html",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "N64",
        "description": "运行 N64 游戏，支持存档"
      }
    }
  },
  "devDependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-toast": "^1.2.15"
  }
}
