{
  "name": "tinker-stock",
  "version": "0.1.0",
  "description": "Stock Plugin for TINKER",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:preload\"",
    "dev:renderer": "vite build --watch",
    "dev:preload": "vite build --watch --config vite.preload.ts",
    "build": "concurrently \"npm run build:renderer\" \"npm run build:preload\"",
    "build:renderer": "vite build",
    "build:preload": "vite build --config vite.preload.ts",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" \"*.{html,json,js,ts}\" --write"
  },
  "keywords": [
    "tinker",
    "stock"
  ],
  "tinker": {
    "name": "Stock",
    "description": "View real-time stock information",
    "main": "dist/renderer/index.html",
    "preload": "dist/preload/index.js",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "股票",
        "description": "查看股票实时信息"
      }
    },
    "mcp": {
      "tools": {
        "search": {
          "description": "Search stocks by keyword. Updates the plugin UI and returns matching symbols with code, name, and type.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "keyword": {
                "type": "string",
                "minLength": 1,
                "description": "Stock name or code keyword (e.g. 茅台, 600519, AAPL)"
              }
            },
            "required": [
              "keyword"
            ]
          }
        },
        "open_stock": {
          "description": "Open a stock detail view by code. Updates the plugin UI and returns quote snapshot, profile, intraday points, and daily K-line.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Stock code (e.g. sh600519, hk00700, usAAPL)"
              },
              "name": {
                "type": "string",
                "description": "Optional display name"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "get_market": {
          "description": "Switch market tab and return data: hot stocks, hot ETFs, sector boards, or IPO calendar.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "tab": {
                "type": "string",
                "enum": [
                  "hot",
                  "etf",
                  "board",
                  "ipo"
                ],
                "description": "Market tab to load"
              }
            },
            "required": [
              "tab"
            ]
          }
        },
        "get_watchlist": {
          "description": "Refresh and return the watchlist with latest quote snapshots.",
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        },
        "add_watch": {
          "description": "Add a symbol to the watchlist, refresh snapshots, and return the updated list.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Stock code to watch (e.g. sh600519)"
              },
              "name": {
                "type": "string",
                "description": "Optional display name"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "remove_watch": {
          "description": "Remove a symbol from the watchlist and return the updated list.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Stock code to remove"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "get_detail": {
          "description": "Switch detail tab for the currently open stock and return that tab's data. Call open_stock first.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "tab": {
                "type": "string",
                "enum": [
                  "overview",
                  "fund",
                  "chip",
                  "finance",
                  "shareholder",
                  "dividend"
                ],
                "description": "Detail tab to load"
              }
            },
            "required": [
              "tab"
            ]
          }
        },
        "get_kline": {
          "description": "Load K-line bars for the currently open stock. Updates the plugin UI and returns OHLCV data. Call open_stock first.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "period": {
                "type": "string",
                "enum": [
                  "day",
                  "week",
                  "month"
                ],
                "description": "K-line period (default day)"
              }
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "westock-data-clawhub": "1.0.4"
  },
  "devDependencies": {
    "klinecharts": "^10.0.0"
  }
}
