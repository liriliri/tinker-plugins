{
  "name": "tinker-weather",
  "version": "0.1.0",
  "description": "Weather Plugin for Tinker",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" \"*.{html,json,js,ts}\" --write"
  },
  "keywords": [
    "tinker",
    "weather"
  ],
  "tinker": {
    "name": "Weather",
    "main": "dist/index.html",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "天气"
      }
    }
  },
  "devDependencies": {
    "pinyin": "^4.0.0"
  }
}
