{
  "name": "tinker-video-converter",
  "version": "0.1.1",
  "description": "Video Format Converter Plugin for TINKER",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
