{
  "name": "tinker-gamepad",
  "version": "0.1.3",
  "description": "Test and visualize gamepad inputs",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:tinker": "vite build --watch",
    "build": "vite build",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" \"*.{html,json,js,ts}\" --write"
  },
  "keywords": [
    "tinker",
    "gamepad"
  ],
  "tinker": {
    "name": "Gamepad",
    "category": "system",
    "main": "dist/index.html",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "手柄测试",
        "description": "测试并可视化游戏手柄输入"
      }
    }
  }
}
