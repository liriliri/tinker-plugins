{
  "name": "tinker-3d-viewer",
  "version": "0.4.0",
  "description": "3D Model Viewer Plugin for TINKER",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:preload\"",
    "dev:renderer": "vite build --watch",
    "dev:preload": "vite build --watch --config vite.preload.ts",
    "build": "concurrently \"npm run build:renderer\" \"npm run build:preload\"",
    "build:renderer": "vite build",
    "build:preload": "vite build --config vite.preload.ts",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" \"*.{html,json,js,ts}\" --write"
  },
  "keywords": [
    "tinker",
    "3d-viewer",
    "3d"
  ],
  "tinker": {
    "name": "3D Viewer",
    "description": "Preview 3D models",
    "main": "dist/renderer/index.html",
    "preload": "dist/preload/index.js",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "3D 预览",
        "description": "预览 3D 模型"
      }
    },
    "mcp": {
      "tools": {
        "open": {
          "description": "Open a local 3D model for preview. Updates the plugin UI and returns model info.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Absolute path to a model file or a folder containing one (glb, gltf, obj, fbx, stl, ply, dae, 3mf, zip)"
              }
            },
            "required": [
              "path"
            ]
          }
        },
        "save": {
          "description": "Save the currently loaded model as GLB or GLTF. Format is taken from the path extension (.glb or .gltf).",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Absolute output path ending in .glb or .gltf. For .gltf, writes a directory of assets next to the file."
              }
            },
            "required": [
              "path"
            ]
          }
        }
      }
    }
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2"
  },
  "devDependencies": {
    "@google/model-viewer": "^4.3.1",
    "@types/three": "^0.185.4",
    "fflate": "^0.8.3",
    "three": "^0.183.2"
  }
}
