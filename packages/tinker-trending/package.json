{
  "name": "tinker-trending",
  "version": "0.2.0",
  "description": "Trending Hot Search Plugin for TINKER",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:preload\"",
    "dev:renderer": "vite build --watch",
    "dev:preload": "vite build --watch --config vite.preload.ts",
    "build": "concurrently \"npm run build:renderer\" \"npm run build:preload\"",
    "build:renderer": "vite build",
    "build:preload": "vite build --config vite.preload.ts",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" \"*.{html,json,js,ts}\" --write"
  },
  "keywords": [
    "tinker",
    "trending"
  ],
  "tinker": {
    "name": "Trending",
    "description": "Browse trending topics from multiple platforms",
    "main": "dist/renderer/index.html",
    "preload": "dist/preload/index.js",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "热搜榜",
        "description": "浏览多个平台的热搜榜"
      }
    },
    "mcp": {
      "tools": {
        "list_sources": {
          "description": "List all available trending sources and which ones are currently active in the plugin UI.",
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        },
        "get_trending": {
          "description": "Refresh and return trending items for a source. Updates the plugin UI cache and returns title, url, and optional extra fields.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "hackernews",
                  "github",
                  "zhihu",
                  "weibo",
                  "v2ex",
                  "bilibili",
                  "douban",
                  "juejin",
                  "toutiao",
                  "sspai",
                  "tieba",
                  "steam"
                ],
                "description": "Source id from list_sources"
              }
            },
            "required": [
              "source"
            ]
          }
        },
        "add_source": {
          "description": "Add a source to the active list, refresh it, and return the updated source list.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "hackernews",
                  "github",
                  "zhihu",
                  "weibo",
                  "v2ex",
                  "bilibili",
                  "douban",
                  "juejin",
                  "toutiao",
                  "sspai",
                  "tieba",
                  "steam"
                ],
                "description": "Source id from list_sources"
              }
            },
            "required": [
              "source"
            ]
          }
        },
        "remove_source": {
          "description": "Remove a source from the active list and return the updated source list.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "hackernews",
                  "github",
                  "zhihu",
                  "weibo",
                  "v2ex",
                  "bilibili",
                  "douban",
                  "juejin",
                  "toutiao",
                  "sspai",
                  "tieba",
                  "steam"
                ],
                "description": "Active source id to remove"
              }
            },
            "required": [
              "source"
            ]
          }
        }
      }
    }
  },
  "devDependencies": {
    "node-html-parser": "^7.0.1"
  }
}
