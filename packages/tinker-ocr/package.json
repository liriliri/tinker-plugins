{
  "name": "tinker-ocr",
  "version": "0.2.0",
  "description": "Recognize text from images using ONNX PaddleOCR",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:preload\"",
    "dev:renderer": "vite build --watch",
    "dev:preload": "vite build --watch --config vite.preload.ts",
    "build": "concurrently \"npm run build:renderer\" \"npm run build:preload\"",
    "build:renderer": "vite build",
    "build:preload": "vite build --config vite.preload.ts",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" \"*.{html,json,js,ts}\" --write"
  },
  "keywords": [
    "tinker",
    "ocr"
  ],
  "tinker": {
    "name": "OCR",
    "category": "productivity",
    "main": "dist/renderer/index.html",
    "preload": "dist/preload/index.mjs",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "OCR 识别",
        "description": "使用 ONNX PaddleOCR 识别图片中的文字"
      }
    },
    "mcp": {
      "tools": {
        "recognize": {
          "description": "Recognize text from a local image file using OCR. Updates the plugin UI and returns the extracted text.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Absolute path to an image file (png, jpg, jpeg, webp, bmp, etc.)"
              },
              "strip_newlines": {
                "type": "boolean",
                "description": "If true, remove newlines from the result. Defaults to the plugin's current setting."
              }
            },
            "required": [
              "path"
            ]
          }
        }
      }
    }
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.9"
  }
}
