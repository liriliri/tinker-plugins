{
  "name": "tinker-ocr",
  "version": "0.1.2",
  "description": "OCR Plugin for TINKER",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" \"*.{html,json,js,ts}\" --write"
  },
  "keywords": [
    "tinker",
    "ocr"
  ],
  "tinker": {
    "name": "OCR",
    "description": "Recognize text from images using Tesseract.js",
    "main": "dist/index.html",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "OCR 识别",
        "description": "使用 Tesseract.js 识别图片中的文字"
      }
    },
    "mcp": {
      "tools": {
        "recognize": {
          "description": "Recognize text from a local image file using OCR. Updates the plugin UI and returns the extracted text.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Absolute path to an image file (png, jpg, jpeg, webp, bmp, etc.)"
              },
              "lang": {
                "type": "string",
                "enum": [
                  "chi_sim+eng",
                  "chi_sim",
                  "eng"
                ],
                "description": "OCR language. Defaults to the plugin's current language setting."
              },
              "strip_newlines": {
                "type": "boolean",
                "description": "If true, remove newlines from the result. Defaults to the plugin's current setting."
              }
            },
            "required": [
              "path"
            ]
          }
        }
      }
    }
  },
  "devDependencies": {
    "tesseract.js": "^7.0.0"
  }
}
