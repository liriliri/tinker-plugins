{
  "name": "tinker-gltf-optimizer",
  "version": "0.2.0",
  "description": "GLTF Optimizer Plugin for TINKER",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:preload\"",
    "dev:renderer": "vite build --watch",
    "dev:preload": "vite build --watch --config vite.preload.ts",
    "build": "concurrently \"npm run build:renderer\" \"npm run build:preload\"",
    "build:renderer": "vite build",
    "build:preload": "vite build --config vite.preload.ts",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" \"*.{html,json,js,ts}\" --write"
  },
  "keywords": [
    "tinker",
    "gltf",
    "gltf-optimizer",
    "3d"
  ],
  "tinker": {
    "name": "GLTF Optimizer",
    "description": "Optimize GLB and GLTF models with Draco, WebP, and mesh simplify",
    "main": "dist/renderer/index.html",
    "preload": "dist/preload/index.js",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "GLTF 优化",
        "description": "使用 Draco、WebP 和网格简化优化 GLB/GLTF 模型"
      }
    },
    "mcp": {
      "tools": {
        "optimize": {
          "description": "Optimize a local GLB or GLTF model with Draco, WebP, and mesh simplify. Updates the plugin UI and returns original/output size and path.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Absolute path to a .glb or .gltf file"
              },
              "quality": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4,
                "description": "Quality preset index: 0 very low, 1 low, 2 medium (default), 3 high, 4 excellent"
              },
              "draco": {
                "type": "boolean",
                "description": "Enable Draco mesh compression. Defaults to true."
              },
              "simplify": {
                "type": "boolean",
                "description": "Enable mesh simplification. Defaults to true."
              },
              "output_dir": {
                "type": "string",
                "description": "Optional output directory. Defaults to the plugin setting or the source file directory."
              }
            },
            "required": [
              "path"
            ]
          }
        }
      }
    }
  },
  "dependencies": {
    "gltf-optimizer": "^0.4.1"
  }
}
