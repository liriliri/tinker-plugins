{
  "name": "tinker-bg-remover",
  "version": "0.2.0",
  "description": "Remove image backgrounds locally with AI",
  "files": [
    "dist/",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liriliri/tinker-plugins.git"
  },
  "scripts": {
    "dev": "NODE_ENV=production vite",
    "dev:tinker": "vite build --watch",
    "build": "vite build",
    "format": "prettier \"src/**/*.{ts,tsx,scss}\" \"*.{html,json,js,ts}\" --write"
  },
  "keywords": [
    "tinker",
    "bg-remover"
  ],
  "tinker": {
    "name": "Background Remover",
    "category": "media",
    "main": "dist/index.html",
    "icon": "icon.png",
    "locales": {
      "zh-CN": {
        "name": "抠图",
        "description": "使用 AI 在本地移除图片背景"
      }
    }
  },
  "devDependencies": {
    "@imgly/background-removal": "^1.7.0",
    "onnxruntime-web": "1.21.0"
  }
}
